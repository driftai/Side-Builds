+_FP8_PACKED_EXPERT_PATTERN = re.compile(
+    r"^model\.layers\.(?P<layer>\d+)\.mlp\.experts\."
+    r"(?P<name>gate_up_proj|gate_up_proj\.weight_scale_inv|down_proj|down_proj\.weight_scale_inv)$"
+)
+
+
+def _build_fp8_expert_banks(
+    model_path: str,
+    model_config,
+    *,
+    dummy: bool,
+    parallel: bool,
+    workers: int,
+    chunk: int,
+    layer_sink=None,
+) -> dict[str, list[torch.Tensor]]:
+    """Build native block-FP8 offload banks from the existing Qwen3 expert iterator."""
+    if get_tp_info().size > 1:
+        raise NotImplementedError("qwen3_moe block-FP8 expert banks currently support TP=1 only")
+
+    from freetoken.kernel.triton.fp8_block_linear import FP8
+    from freetoken.moe.host_banks import LayerCompletionTracker, PinPipeline, alloc_layer_banks
+
+    block = 128
+    num_layers = model_config.num_layers
+    num_experts = model_config.num_experts
+    hidden = model_config.hidden_size
+    intermediate = model_config.moe_intermediate_size
+    if hidden % block or intermediate % block:
+        raise ValueError(
+            "qwen3_moe block-FP8 expert dimensions must be divisible by 128: "
+            f"hidden={hidden}, intermediate={intermediate}"
+        )
+
+    specs = {
+        "gate_up": ((num_experts, 2 * intermediate, hidden), FP8),
+        "gate_up_scale": (
+            (num_experts, 2 * intermediate // block, hidden // block),
+            torch.bfloat16,
+        ),
+        "down": ((num_experts, hidden, intermediate), FP8),
+        "down_scale": (
+            (num_experts, hidden // block, intermediate // block),
+            torch.bfloat16,
+        ),
+    }
+    host_banks = alloc_layer_banks(specs, num_layers)
+    sources = {
+        name: [bank.tensor for bank in host_banks[name]]
+        for name in specs
+    }
+
+    if dummy:
+        for layer in range(num_layers):
+            sources["gate_up"][layer].view(torch.uint8).random_(0, 16)
+            sources["down"][layer].view(torch.uint8).random_(0, 16)
+            sources["gate_up_scale"][layer].fill_(1.0)
+            sources["down_scale"][layer].fill_(1.0)
+        if torch.cuda.is_available():
+            from freetoken.moe.host_banks import pin_banks
+
+            pin_banks(host_banks)
+        return sources
+
+    def place(name: str, tensor: torch.Tensor) -> int:
+        match = _FP8_PACKED_EXPERT_PATTERN.match(name)
+        if match is None:
+            raise ValueError(f"Unexpected qwen3_moe block-FP8 expert weight key: {name}")
+        layer = int(match.group("layer"))
+        if layer < 0 or layer >= num_layers:
+            raise ValueError(f"Unexpected qwen3_moe expert layer {layer}")
+        packed_name = match.group("name")
+        if packed_name == "gate_up_proj":
+            bank_name = "gate_up"
+        elif packed_name == "gate_up_proj.weight_scale_inv":
+            bank_name = "gate_up_scale"
+        elif packed_name == "down_proj":
+            bank_name = "down"
+        else:
+            bank_name = "down_scale"
+        expected = tuple(sources[bank_name][layer].shape)
+        if tuple(tensor.shape) != expected:
+            raise ValueError(
+                f"Unexpected {bank_name} shape {tuple(tensor.shape)}; expected {expected}"
+            )
+        sources[bank_name][layer].copy_(tensor)
+        return layer
+
+    iterator = iter_weights_parallel if parallel else iter_weights
+    kwargs = {
+        "include_moe_experts": True,
+        "include_non_moe": False,
+    }
+    if parallel:
+        kwargs.update(workers=workers, chunk=chunk)
+    tensors = iterator(model_path, torch.device("cpu"), **kwargs)
+
+    def load(sink) -> None:
+        tracker = LayerCompletionTracker(4, host_banks, sink)
+        seen: dict[int, int] = {}
+        for name, tensor in tensors:
+            layer = place(name, tensor)
+            seen[layer] = seen.get(layer, 0) + 1
+            tracker.note(layer)
+        expected = {layer: 4 for layer in range(num_layers)}
+        if seen != expected:
+            raise ValueError(f"Incomplete qwen3_moe block-FP8 expert banks: {seen}")
+
+    if layer_sink is not None:
+        load(layer_sink)
+    else:
+        with PinPipeline() as pins:
+            load(pins)
+    return sources
+
+
+def setup_offload_expert_banks(
+    model_path: str,
+    model_config,
+    *,
+    device: torch.device,
+    dtype: torch.dtype,
+    dummy: bool = False,
+    parallel: bool = False,
+    workers: int = 8,
+    chunk: int = 8 << 20,
+    decode_target: str = "gpu",
+    layer_sink=None,
+):
+    """Model-owned bank setup for Qwen3 block-FP8; defer all existing formats unchanged."""
+    expert_quant = getattr(model_config, "expert_quant", "none")
+    if expert_quant != "fp8_block":
+        from freetoken.moe.expert_banks import _PROVIDERS
+
+        return _PROVIDERS[expert_quant](
+            model_path,
+            model_config,
+            device,
+            dtype,
+            dummy,
+            parallel=parallel,
+            workers=workers,
+            chunk=chunk,
+            decode_target=decode_target,
+            layer_sink=layer_sink,
+        )
+
+    from freetoken.moe.expert_banks import ExpertBanks
+
+    sink = None if dummy else layer_sink
+    sources = _build_fp8_expert_banks(
+        model_path,
+        model_config,
+        dummy=dummy,
+        parallel=parallel,
+        workers=workers,
+        chunk=chunk,
+        layer_sink=sink,
+    )
+    return ExpertBanks("fp8_block", sources, streamed=sink is not None)
+
+
+__all__ = ["iter_weights", "iter_weights_parallel", "setup_offload_expert_banks"]
