# Copy this file to .env.local and put your own key in it.
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit a real key: anything pushed to a public
# repository should be treated as compromised immediately, and it stays in the
# git history even after you delete it.
#
# Get a key from https://aistudio.google.com/apikey
#
# The backend also accepts GEMINI_API_KEY or GOOGLE_API_KEY from the
# environment, and the app's Gemini settings panel can supply one per session.
GEMINI_API_KEY=your_api_key_here
